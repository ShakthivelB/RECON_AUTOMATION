
#!/usr/bin/env bash

# ==========================================
# Automated Bug Bounty Recon
# Tools: subfinder, httpx, gau, katana
# ==========================================

set -Eeuo pipefail

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

banner() {
    echo -e "${RED}"
    cat << 'EOF'
 ____  _____ ____ ___  _   _
|  _ \| ____/ ___/ _ \| \ | |
| |_) |  _|| |  | | | |  \| |
|  _ <| |__| |__| |_| | |\  |
|_| \_\_____\____\___/|_| \_|

       RECON AUTOMATION
       AUTHOR: SHAKTHI
EOF
    echo -e "${NC}"
}

log() {
    echo -e "${GREEN}[+]${NC} $1"
}

VERSION="1.0.0"

show_help() {
    banner

    cat << EOF
USAGE:
    recon [url]

DESCRIPTION:
    Automated reconnaissance framework for authorized
    bug bounty and security testing.

OPTIONS:
    -h, --help       Show this help menu
    -v, --version    Show version information

EXAMPLES:
    recon example.com
    recon https://example.com
    recon -h
    recon --help
    recon -v
    recon --version

RECON WORKFLOW:
    1. Subdomain Enumeration
    2. Live Host Detection
    3. Historical URL Collection
    4. Web Crawling
    5. URL Filtering
    6. JavaScript Discovery
    7. Endpoint Extraction
    8. Potential Secret Detection
    9. Parameter Discovery
    10. Final Recon Summary

EOF
}

warn() {
    echo -e "${YELLOW}[!]${NC} $1"
}

error() {
    echo -e "${RED}[-]${NC} $1"
}

# Check required tools
check_tools() {
    local missing=0

    for tool in subfinder httpx gau katana curl grep sort awk xargs find wc sha256sum; do
    printf "%-12s %s\n" "$tool" "$(command -v "$tool" || echo MISSING)"
done

    if [[ $missing -eq 1 ]]; then
        error "Install missing dependencies before running."
        exit 1
    fi
}

# Validate target
validate_target() {
    DOMAIN="${1:-}"

    if [[ -z "$DOMAIN" ]]; then
        error "Usage: $0 example.com"
        exit 1
    fi

    DOMAIN="${DOMAIN#https://}"
    DOMAIN="${DOMAIN#http://}"
    DOMAIN="${DOMAIN%%/*}"
    DOMAIN="${DOMAIN%.}"

    if [[ ! "$DOMAIN" =~ ^([a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}$ ]]; then
        error "Invalid domain"
        exit 1
    fi
}

# Create output directory
setup_output() {
    DATE=$(date +%Y%m%d_%H%M%S)
    OUT="recon_${DOMAIN}_${DATE}"

    mkdir -p "$OUT"

    log "Output directory: $OUT"
}

# Subdomain enumeration
subdomain_enum() {
    log "Running Subfinder..."

    subfinder -d "$DOMAIN" -all -silent \
        -o "$OUT/subdomains.txt"

    log "Subdomains found: $(wc -l < "$OUT/subdomains.txt")"
}

# Live host detection
live_hosts() {
    log "Checking live hosts with httpx..."

    httpx -l "$OUT/subdomains.txt" -silent \
        -o "$OUT/live.txt"

    log "Live hosts: $(wc -l < "$OUT/live.txt")"

    log "Collecting HTTP metadata..."

    httpx -l "$OUT/live.txt" \
        -status-code -title -tech-detect -silent \
        -o "$OUT/live_details.txt"
}

# Historical URL collection
historical_urls() {
    log "Collecting historical URLs with GAU..."

    gau "$DOMAIN" 2>/dev/null \
        > "$OUT/gau.txt" || true
}

# Active crawling
crawl_urls() {
    log "Crawling live hosts with Katana..."

    katana -list "$OUT/live.txt" \
        -d 3 -js-crawl -silent \
        -o "$OUT/katana.txt" || true
}

# Merge and deduplicate URLs
merge_urls() {
    log "Merging URL results..."

    cat "$OUT/gau.txt" "$OUT/katana.txt" \
        2>/dev/null |
        sort -u > "$OUT/all_urls.txt"

    log "Total URLs: $(wc -l < "$OUT/all_urls.txt")"
}

# Extract interesting endpoints
filter_endpoints() {
    log "Filtering interesting endpoints..."

    grep -Ei \
    '(\?|api|login|auth|admin|upload|redirect|search|callback|token|user|account|graphql)' \
    "$OUT/all_urls.txt" \
    | sort -u > "$OUT/interesting_endpoints.txt" || true

    log "Interesting endpoints: $(wc -l < "$OUT/interesting_endpoints.txt")"
}


# JavaScript discovery and intelligence extraction
js_discovery() {
    log "Extracting JavaScript URLs..."

    grep -Ei '\.js([?#].*)?$' "$OUT/all_urls.txt" \
        | sort -u > "$OUT/js_files.txt" || true

    log "JavaScript files: $(wc -l < "$OUT/js_files.txt")"

    mkdir -p "$OUT/js_downloads"
    mkdir -p "$OUT/js_analysis"

    log "Downloading discovered JavaScript files..."

    local count=0

    while IFS= read -r url; do
        [[ -z "$url" ]] && continue

        count=$((count + 1))

        curl -fsSL --max-time 20 "$url" \
            -o "$OUT/js_downloads/js_${count}.js" || {
                warn "Failed to download: $url"
            }

    done < "$OUT/js_files.txt"

    log "JavaScript download completed."

    # Check whether any JS files were downloaded
    if ! find "$OUT/js_downloads" -type f -name '*.js' -print -quit \
        | grep -q .; then
        warn "No JavaScript files downloaded."
        return 0
    fi

    log "Starting parallel JavaScript extraction with xargs..."

    # 1. Extract endpoints and URLs
    find "$OUT/js_downloads" -type f -name '*.js' -print0 |
    xargs -0 -r -P 10 -I {} sh -c '
        grep -Eo \
        "https?://[^\"[:space:]<>]+|/(api|graphql|v[0-9]+|auth|admin|user|account|internal)/[A-Za-z0-9_./?=&%-]*" \
        "$1" 2>/dev/null || true
    ' _ {} > "$OUT/js_analysis/endpoints_raw.txt"

    sort -u "$OUT/js_analysis/endpoints_raw.txt" \
        > "$OUT/js_analysis/endpoints.txt"

    # 2. Detect potential hardcoded secrets
    find "$OUT/js_downloads" -type f -name '*.js' -print0 |
    xargs -0 -r -P 10 -I {} sh -c '
        grep -Ein \
        "(api[_-]?key|access[_-]?token|client[_-]?secret|secret[_-]?key|authorization|password)[[:space:]]*[:=]" \
        "$1" 2>/dev/null || true
    ' _ {} > "$OUT/js_analysis/potential_secrets.txt"

    # 3. Extract interesting keywords
    find "$OUT/js_downloads" -type f -name '*.js' -print0 |
    xargs -0 -r -P 10 -I {} sh -c '
        grep -Ein \
        "admin|internal|staging|debug|graphql|swagger|password|token|secret|api" \
        "$1" 2>/dev/null || true
    ' _ {} > "$OUT/js_analysis/interesting_strings.txt"

    # 4. Extract parameter names
    find "$OUT/js_downloads" -type f -name '*.js' -print0 |
    xargs -0 -r -P 10 -I {} sh -c '
        grep -Eo \
        "[?&][A-Za-z_][A-Za-z0-9_-]*=" \
        "$1" 2>/dev/null || true
    ' _ {} | sort -u > "$OUT/js_analysis/parameters.txt"

    log "JavaScript intelligence extraction completed."

    log "Extracted endpoints: $(wc -l < "$OUT/js_analysis/endpoints.txt")"
    log "Potential secret matches: $(wc -l < "$OUT/js_analysis/potential_secrets.txt")"
    log "Interesting strings: $(wc -l < "$OUT/js_analysis/interesting_strings.txt")"
    log "Parameters: $(wc -l < "$OUT/js_analysis/parameters.txt")"
}

# Parameter discovery
parameter_discovery() {
    log "Extracting parameterized URLs..."

    grep -F '?' "$OUT/all_urls.txt" \
        | sort -u > "$OUT/parameter_urls.txt" || true
}

# Final summary
summary() {
    echo
    echo -e "${GREEN}===================================="
    echo "          RECON COMPLETED"
    echo "====================================${NC}"

    echo "Target:       $DOMAIN"
    echo "Subdomains:   $(wc -l < "$OUT/subdomains.txt")"
    echo "Live hosts:   $(wc -l < "$OUT/live.txt")"
    echo "All URLs:     $(wc -l < "$OUT/all_urls.txt")"
    echo "Endpoints:    $(wc -l < "$OUT/interesting_endpoints.txt")"
    echo "JS Endpoints:  $(wc -l < "$OUT/js_analysis/endpoints.txt")"
    echo "JS Secrets:    $(wc -l < "$OUT/js_analysis/potential_secrets.txt")"
    echo "JS Parameters: $(wc -l < "$OUT/js_analysis/parameters.txt")"

    echo
    log "Results saved in: $OUT"
}

# ==========================================
# MAIN
# ==========================================

# Handle help and version options
case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;

    -v|--version)
        echo "recon version $VERSION"
        exit 0
        ;;
esac

# Normal execution
banner
validate_target "${1:-}"
check_tools
setup_output

log "Starting authorized reconnaissance for $DOMAIN"

subdomain_enum
live_hosts
historical_urls
crawl_urls
merge_urls
filter_endpoints
js_discovery
parameter_discovery
summary

